# Port the server listens on
PORT=3001
# Where the SQLite database file lives. Put it on a persistent disk in production.
# Uploaded photos go in an "uploads" folder next to it (or set UPLOAD_DIR).
DATABASE_PATH=data/jd-residency.db
# First admin account (only used the very first time the database is created)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Optional: fixed secret for login sessions (otherwise one is generated and stored in the database)
# SESSION_SECRET=
# Timezone used for "today" (arrivals, departures, etc.)
HOTEL_TIMEZONE=Asia/Kolkata
