# Port the server listens on
PORT=3001
# Postgres connection string (e.g. from Neon). Leave unset to use the built-in database in data/pglite.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# First admin account (only used the very first time the database is created)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Fixed secret for login sessions (otherwise one is generated and stored in the database)
# SESSION_SECRET=
# Timezone used for "today" (arrivals, departures, etc.)
HOTEL_TIMEZONE=Asia/Kolkata
# Add sample bookings when the database is brand new (for demos)
# DEMO_DATA=1
# WhatsApp Cloud API access token (optional; can also be saved in the admin panel)
# WHATSAPP_TOKEN=
# Razorpay keys for online payment (optional; can also be saved in the admin panel)
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
