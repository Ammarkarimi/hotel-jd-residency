{
  "name": "hotel-jd-residency",
  "private": true,
  "version": "1.0.0",
  "description": "Website and management panel for Hotel JD Residency",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning server/index.js & vite",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "express": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.7"
  }
}
